<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ClaudeMultiAccount</AssemblyName>
    <RootNamespace>ClaudeMultiAccount</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Claude Multi-Account Launcher</Product>
    <Description>Run several Claude Desktop accounts side by side on Windows.</Description>
    <Copyright>MIT License</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF owns DPI awareness (app.manifest); WinForms is only used for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
