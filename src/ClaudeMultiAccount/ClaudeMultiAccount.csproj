<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ClaudeMultiAccount</AssemblyName>
    <RootNamespace>ClaudeMultiAccount</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Release builds take the version from the git tag (see .github/workflows/build.yml). -->
    <Version>1.0.0</Version>
    <!-- Product name = project name: code signing (SignPath) checks it. -->
    <Product>Claude Multi-Account</Product>
    <AssemblyTitle>Claude Multi-Account</AssemblyTitle>
    <Description>Run several Claude Desktop accounts side by side on Windows.</Description>
    <Copyright>Copyright (c) 2026 Antonio Vitor. MIT License.</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF owns DPI awareness (app.manifest); WinForms is only used for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeMultiAccount.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
