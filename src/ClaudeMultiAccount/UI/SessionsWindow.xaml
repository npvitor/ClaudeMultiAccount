<Window x:Class="ClaudeMultiAccount.UI.SessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClaudeMultiAccount.Localization"
        Icon="/ClaudeMultiAccount;component/Assets/app.ico"
        Width="640" Height="560" MinWidth="520" MinHeight="400" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Row="1" Text="{x:Static loc:S.SessionsHint}" Style="{StaticResource Hint}" Margin="0,6,0,0" />

        <DockPanel Grid.Row="2" Margin="2,14,2,8">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center" />
            <CheckBox x:Name="SelectAll" Content="{x:Static loc:S.SessionsSelectAll}" FontSize="13" Foreground="{StaticResource Ink}"
                      Click="SelectAll_Click" />
        </DockPanel>

        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <ListBox x:Name="SessionList" BorderThickness="0" Background="Transparent" Margin="2"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked}" Margin="4,6" VerticalContentAlignment="Top" Click="Item_Click">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" Style="{StaticResource Hint}" Margin="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
            </Grid>
        </Border>

        <!-- Status -->
        <StackPanel x:Name="StatusPanel" Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" BorderThickness="0"
                         Foreground="{StaticResource Accent}" Background="{StaticResource AccentSoft}" />
        </StackPanel>

        <!-- Actions -->
        <DockPanel x:Name="ActionsPanel" Grid.Row="5" Margin="0,16,0,0" LastChildFill="False">
            <StackPanel x:Name="CopyPanel" DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="{x:Static loc:S.SessionsCopyTo}" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                <ComboBox x:Name="TargetBox" Margin="8,0,0,0" MinWidth="150" MaxWidth="200" VerticalAlignment="Center" FontSize="13"
                          DisplayMemberPath="Name" />
                <Button x:Name="CopyButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{x:Static loc:S.SessionsCopy}"
                        Click="Copy_Click" />
            </StackPanel>
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{x:Static loc:S.Close}"
                    IsCancel="True" />
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                    Content="{x:Static loc:S.SessionsSaveFile}" Click="Save_Click" />
        </DockPanel>
    </Grid>
</Window>
